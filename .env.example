# ---------------------------------------------------------------------------
# Smart Placement Management System - environment configuration template
# ---------------------------------------------------------------------------
# Copy this file to `.env` in the repository root and fill in real values.
# `.env` is git-ignored and MUST never be committed.
#   PowerShell:  Copy-Item .env.example .env
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
# Generate a strong key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-50-character-random-string

# Development: True | Production: False
DJANGO_DEBUG=True

# Comma separated list of allowed hosts.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma separated list of allowed CORS origins (frontend dev server).
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Database (MySQL 8.x) --------------------------------------------------
DB_NAME=placement_management
DB_USER=replace-me
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=3306

# --- JWT lifetimes (minutes / days) ----------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# --- Frontend build output -------------------------------------------------
# Optional: base URL of the deployed backend used by the frontend.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
